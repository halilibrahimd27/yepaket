# =============================================================================
# YePaket — üretim ortam değişkenleri
#
#   cp .env.prod.example .env.prod
#   # değerleri doldurun
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# BU DOSYANIN DOLDURULMUŞ HÂLİ VERSİYON KONTROLÜNE GİRMEZ.
# Sunucuda izinlerini kısın:  chmod 600 .env.prod
# =============================================================================

# -----------------------------------------------------------------------------
# Alan adları
#
# Her ikisinin de A (ve varsa AAAA) kaydı bu sunucuyu göstermelidir.
# Göstermezse Caddy Let's Encrypt sertifikası alamaz ve site açılmaz.
# -----------------------------------------------------------------------------
WEB_DOMAIN=yepaket.app
API_DOMAIN=api.yepaket.app
# Sertifika süresi dolmak üzereyken uyarı bu adrese gelir.
ACME_EMAIL=teknik@yepaket.app

# Uygulamanın kendini nasıl gördüğü — e-posta bağlantıları buradan üretilir.
API_PUBLIC_URL=https://api.yepaket.app
WEB_APP_URL=https://yepaket.app

# Tarayıcıdan API'ye istek atmasına izin verilen origin'ler (virgülle ayrılır).
# `*` üretimde REDDEDİLİR: uygulama açılışta hata verip durur.
CORS_ORIGINS=https://yepaket.app,https://www.yepaket.app

# Mobil derin bağlantı şeması (şifre sıfırlama e-postasında kullanılır).
MOBILE_DEEP_LINK_SCHEME=yepaket

# -----------------------------------------------------------------------------
# Veritabanı ve önbellek
#
# Şifreleri rastgele üretin:  openssl rand -base64 32
# -----------------------------------------------------------------------------
POSTGRES_USER=yepaket
POSTGRES_PASSWORD=
POSTGRES_DB=yepaket
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Kimlik sırları
#
# HER BİRİ EN AZ 32 KARAKTER ve birbirinden farklı olmalı:
#   openssl rand -base64 48
#
# Bu değerleri değiştirmek tüm kullanıcıların oturumunu kapatır.
# Sızarsa DERHAL değiştirin — sızmış bir imza anahtarıyla saldırgan
# istediği kullanıcı adına jeton üretebilir.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# Ödeme (iyzico)
#
# `mock` üretimde REDDEDİLİR — uygulama açılmaz. Bu bilinçlidir: sahte
# ödeme sağlayıcısıyla yayına çıkmak, para almadan sipariş oluşturmak demek.
#
# Anahtarlar: iyzico Merchant Panel → Ayarlar → API Anahtarları
# Canlı adres: https://api.iyzipay.com
# Test adresi: https://sandbox-api.iyzipay.com
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# -----------------------------------------------------------------------------
# E-posta
#
# Şifre sıfırlama, sipariş onayı ve destek yanıtları buradan gider.
# SMTP çalışmazsa kullanıcı şifresini sıfırlayamaz — bu kritik bir bağımlılık.
#
# Gönderen alan adı için SPF, DKIM ve DMARC kayıtları tanımlanmalı; aksi
# hâlde e-postalar gereksiz (spam) klasörüne düşer.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=YePaket <bilgi@yepaket.app>

# -----------------------------------------------------------------------------
# Sosyal giriş
#
# Virgülle ayrılmış istemci kimlikleri. Boş bırakılan sağlayıcı devre dışı
# kalır ve o sağlayıcıyla giriş denemeleri reddedilir.
#
# Google için hem web hem iOS hem Android istemci kimlikleri listelenmeli:
# sunucu jetonun `aud` alanını bu listeye karşı doğrular.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
MICROSOFT_CLIENT_IDS=

# -----------------------------------------------------------------------------
# Push bildirimi (Firebase Cloud Messaging)
#
# Firebase Console → Proje ayarları → Servis hesapları → Yeni özel anahtar
# İndirilen JSON'u TEK SATIR hâline getirip buraya yapıştırın:
#   jq -c . servis-hesabi.json
#
# Boş bırakılırsa push gönderilmez; bildirimler yalnızca uygulama içinde
# görünür ve uygulama hata vermez.
# -----------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Web derleme değişkenleri
#
# NEXT_PUBLIC_* değerleri tarayıcıya gönderilen pakete DERLEME SIRASINDA
# gömülür. Değiştirdiğinizde web imajını yeniden derlemeniz gerekir:
#   docker compose -f docker-compose.prod.yml build web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.yepaket.app/v1
NEXT_PUBLIC_SITE_URL=https://yepaket.app

# -----------------------------------------------------------------------------
# İşletme kuralları
# -----------------------------------------------------------------------------
# Platform komisyonu, baz puan (1200 = %12). İşletme bazında ayrıca
# yönetim panelinden değiştirilebilir.
DEFAULT_COMMISSION_BPS=1200

# -----------------------------------------------------------------------------
# İşletimsel
# -----------------------------------------------------------------------------
LOG_LEVEL=info
IMAGE_TAG=latest
# Apple Silicon sunucuda çalıştırıyorsanız değiştirmeyin; imresamu/postgis
# hem amd64 hem arm64 destekler.
POSTGRES_IMAGE=imresamu/postgis:17-3.5
