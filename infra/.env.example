# Yerel geliştirme altyapısı (docker compose) ayarları.
# `cp .env.example .env` ile kopyalayın. Gerçek .env dosyası versiyonlanmaz.

# Çok mimarili PostGIS imajı (Apple Silicon dahil). Yalnızca amd64 sunucularda
# resmi imaja geçebilirsiniz: postgis/postgis:17-3.5
POSTGRES_IMAGE=imresamu/postgis:17-3.5

POSTGRES_USER=yepaket
POSTGRES_PASSWORD=yepaket_dev
POSTGRES_DB=yepaket
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
