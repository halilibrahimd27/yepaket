# YePaket API ortam değişkenleri.
# `cp .env.example .env` ile kopyalayın. Gerçek .env dosyası versiyonlanmaz.
#
# Uygulama açılışta bu değerleri doğrular (src/config/env.ts); eksik veya
# geçersiz bir değer varsa süreç başlamaz.

NODE_ENV=development
PORT=8080
API_PUBLIC_URL=http://localhost:8080
LOG_LEVEL=debug

# Virgülle ayrılmış izinli origin listesi.
# Web geliştirme sunucusu 3000, Flutter web 5000 portunda çalışır.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# infra/docker-compose.yml ile aynı kimlik bilgileri.
DATABASE_URL=postgresql://yepaket:yepaket_dev@localhost:5432/yepaket
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Kimlik doğrulama
# ---------------------------------------------------------------------------
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN. Rastgele üretmek için:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=gelistirme_icin_en_az_otuz_iki_karakterlik_gizli_anahtar
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=gelistirme_icin_farkli_ve_en_az_otuz_iki_karakterlik_anahtar
REFRESH_TTL_DAYS=60

# Sosyal giriş istemci kimlikleri (virgülle ayrılmış; her platformun ayrı
# kimliği olur). Boş bırakılan sağlayıcı devre dışıdır.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
MICROSOFT_CLIENT_IDS=

# Gerçek sağlayıcı jetonu üretmeden sosyal girişi denemek için:
#   idToken = "mock:<saglayici-hesap-id>:<e-posta>"
# Üretimde açılamaz; şema doğrulaması reddeder.
OAUTH_ALLOW_MOCK=true

# ---------------------------------------------------------------------------
# Sipariş kuralları
# ---------------------------------------------------------------------------
# Ödeme onayı gelmezse rezervasyon bu süre sonunda geri verilir.
ORDER_RESERVATION_TTL_MINUTES=15
PICKUP_NONCE_TTL_MINUTES=10
SHARED_PICKUP_TTL_MINUTES=120
# Teslim aralığına bu süreden az kaldıysa ücretsiz iptal kapanır.
FREE_CANCEL_WINDOW_MINUTES=120
# Platform komisyonu, baz puan cinsinden (1200 = %12).
DEFAULT_COMMISSION_BPS=1200

# ---------------------------------------------------------------------------
# Ödeme
# ---------------------------------------------------------------------------
# Geliştirmede `mock`; üretimde `iyzico` zorunludur.
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ---------------------------------------------------------------------------
# E-posta (geliştirmede Mailpit yakalar: http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=YePaket <bilgi@yepaket.app>

# ---------------------------------------------------------------------------
# Diğer
# ---------------------------------------------------------------------------
# Belirtilmezse geliştirmede açık, üretimde kapalıdır.
# SWAGGER_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
